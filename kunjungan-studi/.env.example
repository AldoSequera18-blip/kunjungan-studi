# Salin file ini menjadi .env.local lalu sesuaikan bila perlu.

# Kunci rahasia untuk menandatangani cookie sesi.
# WAJIB diganti saat deploy ke server produksi.
SESSION_SECRET=ganti-dengan-kalimat-acak-yang-panjang-dan-rahasia

# URL publik opsional. Jika kosong, URL QR memakai host halaman yang sedang dibuka.
# Untuk VPS produksi gunakan misalnya https://kunjungan.domain-anda.id
PUBLIC_BASE_URL=
# PostgreSQL Supabase, hanya digunakan di server (jangan pakai NEXT_PUBLIC_).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
