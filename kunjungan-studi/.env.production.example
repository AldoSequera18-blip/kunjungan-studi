# Domain publik yang DNS A record-nya mengarah ke IP VPS.
DOMAIN=kunjungan.domain-anda.id
PUBLIC_BASE_URL=https://kunjungan.domain-anda.id

# Akun admin pertama yang dibuat otomatis saat database produksi masih kosong.
INITIAL_ADMIN_EMAIL=admin@domain-anda.id
INITIAL_ADMIN_PASSWORD=ganti-dengan-password-acak-minimal-16-karakter
INITIAL_ADMIN_NAME=Administrator Balai
