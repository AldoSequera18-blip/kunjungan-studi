# Domain publik yang DNS A record-nya mengarah ke IP VPS.
DOMAIN=kunjungan.domain-anda.id
PUBLIC_BASE_URL=https://kunjungan.domain-anda.id

# Koneksi PostgreSQL Supabase khusus server. Gunakan Session Pooler jika VPS
# tidak mendukung IPv6; ambil URI dari Supabase > Connect.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

